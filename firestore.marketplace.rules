rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /sellerApplications/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'country',
          'sellerType',
          'businessName',
          'legalName',
          'taxId',
          'representativeName',
          'email',
          'phone',
          'productCategory',
          'businessDescription',
          'status',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.country == 'PE'
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'seller'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.email == "vignahome@vignahome.com"
        );

      allow update: if request.auth != null
        && request.auth.token.email == "vignahome@vignahome.com"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in [
          "pending",
          "approved",
          "rejected",
          "suspended"
        ]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.token.email;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if (
          request.auth != null
          && (
            resource.data.sellerId == request.auth.uid
            || request.auth.token.email == "vignahome@vignahome.com"
          )
        )
        || (
          resource.data.status == "published"
          && exists(
            /databases/$(database)/documents/sellerApplications/$(resource.data.sellerId)
          )
          && get(
            /databases/$(database)/documents/sellerApplications/$(resource.data.sellerId)
          ).data.status == "approved"
        );
      allow list: if resource.data.status == "published";

      allow create: if request.auth != null
        && exists(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        ).data.status == "approved"
        && request.resource.data.keys().hasOnly([
          "sellerId",
          "sellerName",
          "name",
          "sku",
          "category",
          "description",
          "price",
          "stock",
          "status",
          "createdAt",
          "updatedAt",
          "imageUrl",
          "imagePath"
        ])
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerName
          == get(
            /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
          ).data.businessName
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.sku is string
        && request.resource.data.sku.size() > 0
        && request.resource.data.category is string
        && request.resource.data.description is string
        && (
          request.resource.data.price is int
          || request.resource.data.price is float
        )
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.status == "draft"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !("imageUrl" in request.resource.data)
          || request.resource.data.imageUrl is string
        )
        && (
          !("imagePath" in request.resource.data)
          || request.resource.data.imagePath is string
        );

      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && exists(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        ).data.status == "approved"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "sellerName",
            "name",
            "sku",
            "category",
            "description",
            "price",
            "stock",
            "status",
            "updatedAt",
            "imageUrl",
            "imagePath"
          ])
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.sellerName
          == get(
            /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
          ).data.businessName
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.sku is string
        && request.resource.data.sku.size() > 0
        && request.resource.data.category is string
        && request.resource.data.description is string
        && (
          request.resource.data.price is int
          || request.resource.data.price is float
        )
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.status != "published"
          || (
            "imageUrl" in request.resource.data
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && "imagePath" in request.resource.data
            && request.resource.data.imagePath is string
            && request.resource.data.imagePath.size() > 0
          )
        );

      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && exists(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/sellerApplications/$(request.auth.uid)
        ).data.status == "approved"
        && resource.data.status in ["draft", "published"];
    }

    match /customers/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "phone",
          "country",
          "role",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.country == "PE"
        && request.resource.data.role == "customer"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.email == "vignahome@vignahome.com"
        );

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "name",
            "phone",
            "updatedAt"
          ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.country == resource.data.country
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}