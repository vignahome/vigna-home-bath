rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("activo", true) != false;
    }

    function adminRol() {
      return esAdmin() ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("rol", "superadmin") : "";
    }

    function adminPuede(rol) {
      return esAdmin() && (adminRol() == "superadmin" || adminRol() == "admin" || adminRol() == rol);
    }

    match /admins/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /clientes/{uid} {
      allow create: if autenticado() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow read, update: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow delete: if esAdmin();
    }

    match /pedidos/{pedidoId} {
      allow read: if esAdmin() || (
        autenticado() &&
        resource.data.comprador.email == request.auth.token.email
      );
      allow write: if esAdmin();
    }

    match /inventario/{sku} {
      allow read, write: if esAdmin();
    }

    match /movimientosInventario/{movimientoId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Compatibilidad de lectura con la demostración externa de profesionales.
    match /plomeros/{perfilId} {
      allow read: if true;
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
      allow update: if esAdmin() || (autenticado() && resource.data.uid == request.auth.uid);
      allow delete: if esAdmin();
    }

    match /usuarios/{usuarioId} {
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
      allow read, update: if esAdmin() || (autenticado() && resource.data.uid == request.auth.uid);
      allow delete: if esAdmin();
    }

    match /solicitudes/{solicitudId} {
      allow create: if autenticado() && request.resource.data.clienteId == request.auth.uid;
      allow read: if esAdmin() || autenticado();
      allow update: if esAdmin() || (autenticado() && resource.data.clienteId == request.auth.uid);
      allow delete: if esAdmin();
    }

    match /notificaciones/{notificacionId} {
      allow read: if esAdmin() || (autenticado() && resource.data.usuarioId == request.auth.uid);
      allow create: if autenticado();
      allow update, delete: if esAdmin() || (autenticado() && resource.data.usuarioId == request.auth.uid);
    }

    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if autenticado() && request.resource.data.clienteId == request.auth.uid;
      allow update, delete: if esAdmin();
    }

    // Profesionales Vigna’s: datos aislados del comercio electrónico.
    function pvRol(rol) {
      return autenticado() &&
        get(/databases/$(database)/documents/pv_usuarios/$(request.auth.uid)).data.rol == rol;
    }

    function pvEsProfesionalCompatible(solicitud) {
      return pvRol("profesional") &&
        get(/databases/$(database)/documents/pv_profesionales/$(request.auth.uid)).data.estado == "Aprobado" &&
        get(/databases/$(database)/documents/pv_profesionales/$(request.auth.uid)).data.profesiones.hasAny([solicitud.profesion]);
    }

    match /pv_usuarios/{uid} {
      allow create: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.rol in ["cliente", "profesional"];
      allow read: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow update: if esAdmin() || (
        autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.rol == resource.data.rol &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "correo", "estadoRegistro", "creadoEn"
        ])
      );
      allow delete: if esAdmin();
    }

    match /pv_preferencias_notificaciones/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow create, update: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly([
          "uid", "notificacionesVistasEn", "actualizadoEn"
        ]) &&
        request.resource.data.notificacionesVistasEn is string &&
        request.resource.data.actualizadoEn is string;
      allow delete: if false;
    }

    match /pv_solicitudes_eliminacion/{uid} {
      allow create: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.correo == request.auth.token.email &&
        request.resource.data.estado == "Pendiente" &&
        request.resource.data.motivo is string && request.resource.data.motivo.size() <= 500;
      allow read: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow update: if esAdmin() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.correo == resource.data.correo &&
        request.resource.data.solicitadoEn == resource.data.solicitadoEn &&
        request.resource.data.estado in ["En proceso", "Completada", "Rechazada"] &&
        request.resource.data.notaAdministrativa is string &&
        (request.resource.data.estado != "Completada" || request.resource.data.notaAdministrativa.size() >= 10) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "notaAdministrativa", "atendidoPorUid", "atendidoPorCorreo",
          "actualizadoEn", "completadoEn"
        ]);
      allow delete: if false;
    }

    match /pv_profesionales/{uid} {
      allow read: if resource.data.estado == "Aprobado" || esAdmin() ||
        (autenticado() && request.auth.uid == uid);
      allow create: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid && request.resource.data.estado == "Pendiente" &&
        request.resource.data.profesiones is list &&
        request.resource.data.profesiones.size() >= 1 &&
        request.resource.data.profesiones.size() <= 10;
      allow update: if adminPuede("moderacion") || (
        autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.estado == resource.data.estado &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nombres", "apellidos", "correo", "whatsapp", "modalidad",
          "nombrePublico", "ruc", "idiomas", "disponibilidad",
          "departamento", "provincia", "distrito", "profesiones",
          "profesionPrincipal", "experiencia", "coberturaTipo",
          "coberturaDetalle", "cobertura", "distancia", "recargo", "descripcion",
          "fotoIniciales", "portafolio", "actualizadoEn"
        ])
      );
      allow delete: if adminPuede("moderacion");
    }

    match /pv_profesionales_privados/{uid} {
      allow create: if esAdmin() || (autenticado() && request.auth.uid == uid &&
        request.resource.data.documentoVenceEn is string);
      allow read, update: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow delete: if esAdmin();
    }

    match /pv_profesiones_profesional/{especialidadId} {
      allow read: if resource.data.estado == "Aprobada" || esAdmin() ||
        (autenticado() && resource.data.profesionalUid == request.auth.uid);
      allow create: if adminPuede("moderacion") || (
        pvRol("profesional") &&
        request.resource.data.id == especialidadId &&
        request.resource.data.profesionalUid == request.auth.uid &&
        request.resource.data.estado == "Pendiente" &&
        request.resource.data.principal is bool
      );
      allow update: if adminPuede("moderacion") || (
        pvRol("profesional") && resource.data.profesionalUid == request.auth.uid &&
        request.resource.data.profesionalUid == resource.data.profesionalUid &&
        (request.resource.data.estado == resource.data.estado || request.resource.data.estado == "Pendiente") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "principal", "experiencia", "descripcion", "evidencias", "estado", "actualizadoEn"
        ])
      );
      allow delete: if adminPuede("moderacion");
    }

    match /pv_coberturas/{uid} {
      allow read: if true;
      allow create, update: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.profesionalUid == uid &&
        request.resource.data.tipo in ["Nacional", "Departamentos", "Provincias", "Distritos", "Local", "Remoto"] &&
        request.resource.data.departamentos is list &&
        request.resource.data.provincias is list &&
        request.resource.data.distritos is list &&
        request.resource.data.exclusiones is list &&
        request.resource.data.distanciaKm is number &&
        request.resource.data.distanciaKm >= 0;
      allow delete: if esAdmin();
    }

    match /pv_planes_profesionales/{uid} {
      allow read: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow create, update: if adminPuede("finanzas") || (
        pvRol("profesional") && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.profesionalUid == uid &&
        ((request.resource.data.tipo == "" && request.resource.data.estado == "Sin plan") ||
         (request.resource.data.tipo in ["Mensual", "Semestral", "Anual"] && request.resource.data.estado == "Pendiente de pago")) &&
        request.resource.data.activadoEn == "" &&
        request.resource.data.venceEn == ""
      );
      allow delete: if esAdmin();
    }

    // Los pagos de planes solo pueden ser escritos por el servidor verificado.
    match /pv_pagos_planes/{pagoId} {
      allow read: if esAdmin() || (
        autenticado() && resource.data.profesionalUid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /pv_clientes/{uid} {
      allow create: if autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == uid && request.resource.data.estado == "Pendiente" &&
        request.resource.data.documentoVenceEn is string;
      allow read: if esAdmin() || (autenticado() && request.auth.uid == uid);
      allow update: if esAdmin() || (
        autenticado() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.estado == resource.data.estado
      );
      allow delete: if esAdmin();
    }

    match /pv_solicitudes/{solicitudId} {
      allow create: if pvRol("cliente") &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.autorizacion == true &&
        request.resource.data.tipoNecesidad is string &&
        request.resource.data.subcategoria is string &&
        request.resource.data.situacionActual is string &&
        request.resource.data.resultadoEsperado is string &&
        request.resource.data.estado == "Enviada";
      allow read: if esAdmin() || (
        autenticado() && (
          resource.data.clienteUid == request.auth.uid ||
          resource.data.profesionalUid == request.auth.uid ||
          pvEsProfesionalCompatible(resource.data)
        )
      );
      allow update: if esAdmin() || (
        pvRol("cliente") &&
        resource.data.clienteUid == request.auth.uid &&
        request.resource.data.clienteUid == resource.data.clienteUid &&
        resource.data.estado in ["Enviada", "Cotizada"] &&
        request.resource.data.estado == "Contratada" &&
        request.resource.data.profesionalUid is string &&
        request.resource.data.profesionalUid != "" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "profesionalUid", "actualizadoEn"
        ])
      );
      allow delete: if esAdmin();
    }

    match /pv_portafolios/{proyectoId} {
      allow read: if resource.data.estado == "Aprobado" || esAdmin() ||
        (autenticado() && resource.data.profesionalUid == request.auth.uid);
      allow create: if pvRol("profesional") &&
        request.resource.data.id == proyectoId &&
        request.resource.data.profesionalUid == request.auth.uid &&
        request.resource.data.consentimientoPublicacion == true &&
        request.resource.data.estado == "Pendiente";
      allow update: if adminPuede("moderacion");
      allow delete: if adminPuede("moderacion");
    }

    match /pv_cotizaciones/{cotizacionId} {
      allow create: if pvRol("profesional") &&
        request.resource.data.profesionalUid == request.auth.uid &&
        get(/databases/$(database)/documents/pv_profesionales/$(request.auth.uid)).data.estado == "Aprobado" &&
        get(/databases/$(database)/documents/pv_profesionales/$(request.auth.uid)).data.profesiones.hasAny([
          get(/databases/$(database)/documents/pv_solicitudes/$(request.resource.data.solicitudId)).data.profesion
        ]) &&
        get(/databases/$(database)/documents/pv_solicitudes/$(request.resource.data.solicitudId)).data.clienteUid == request.resource.data.clienteUid &&
        get(/databases/$(database)/documents/pv_solicitudes/$(request.resource.data.solicitudId)).data.profesionalUid in ["", request.auth.uid] &&
        request.resource.data.estado == "Enviada" &&
        request.resource.data.garantiaDias is int &&
        request.resource.data.garantiaDias >= 1 &&
        request.resource.data.garantiaDias <= 3650 &&
        request.resource.data.validaHasta is string &&
        request.resource.data.disponibilidadEstimada is string &&
        request.resource.data.exclusiones is string &&
        request.resource.data.version is int &&
        request.resource.data.version >= 1 &&
        request.resource.data.cotizacionRaizId is string &&
        request.resource.data.opciones is list &&
        request.resource.data.opciones.size() == 3 &&
        request.resource.data.opciones[0].precio > 0 &&
        request.resource.data.opciones[1].precio > 0 &&
        request.resource.data.opciones[2].precio > 0 &&
        request.resource.data.formaPago is string &&
        request.resource.data.formaPago.size() >= 10;
      allow read: if esAdmin() || (
        autenticado() && (
          resource.data.clienteUid == request.auth.uid ||
          resource.data.profesionalUid == request.auth.uid
        )
      );
      allow update: if esAdmin() || (
        pvRol("cliente") && resource.data.clienteUid == request.auth.uid &&
        resource.data.estado == "Enviada" &&
        request.resource.data.estado == "Aceptada" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "actualizadoEn"])
      );
      allow delete: if esAdmin();
    }

    match /pv_contratos/{contratoId} {
      function cotizacionSeleccionada() {
        return get(/databases/$(database)/documents/pv_cotizaciones/$(request.resource.data.cotizacionId)).data;
      }

      allow create: if pvRol("cliente") &&
        request.resource.data.id == contratoId &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.estado == "Pendiente de firma" &&
        request.resource.data.version == 1 &&
        request.resource.data.archivoFirmado == "" &&
        request.resource.data.archivoFirmadoUrl == "" &&
        request.resource.data.anexoPlanTrabajoNombre == "" &&
        request.resource.data.anexoPlanTrabajoRuta == "" &&
        request.resource.data.anexoPlanTrabajoActualizadoEn == "" &&
        request.resource.data.desglose is map &&
        request.resource.data.desglose.materiales is number &&
        request.resource.data.desglose.manoObra is number &&
        request.resource.data.desglose.otros is number &&
        request.resource.data.total >= request.resource.data.desglose.materiales + request.resource.data.desglose.manoObra + request.resource.data.desglose.otros - 0.01 &&
        request.resource.data.total <= request.resource.data.desglose.materiales + request.resource.data.desglose.manoObra + request.resource.data.desglose.otros + 0.01 &&
        request.resource.data.formaPago is string &&
        cotizacionSeleccionada().clienteUid == request.auth.uid &&
        cotizacionSeleccionada().estado == "Enviada" &&
        request.resource.data.solicitudId == cotizacionSeleccionada().solicitudId &&
        request.resource.data.profesionalUid == cotizacionSeleccionada().profesionalUid &&
        request.resource.data.garantiaDias == cotizacionSeleccionada().garantiaDias && (
          (
            request.resource.data.opcion == cotizacionSeleccionada().opciones[0].nombre &&
            request.resource.data.total == cotizacionSeleccionada().opciones[0].precio
          ) || (
            request.resource.data.opcion == cotizacionSeleccionada().opciones[1].nombre &&
            request.resource.data.total == cotizacionSeleccionada().opciones[1].precio
          ) || (
            request.resource.data.opcion == cotizacionSeleccionada().opciones[2].nombre &&
            request.resource.data.total == cotizacionSeleccionada().opciones[2].precio
          )
        );
      allow read: if esAdmin() || (
        autenticado() && (
          resource.data.clienteUid == request.auth.uid ||
          resource.data.profesionalUid == request.auth.uid
        )
      );
      allow update: if esAdmin() || (
        autenticado() &&
        request.resource.data.clienteUid == resource.data.clienteUid &&
        request.resource.data.profesionalUid == resource.data.profesionalUid &&
        (
          (
            (resource.data.clienteUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid) &&
            resource.data.estado == "Pendiente de firma" &&
            request.resource.data.estado == "Pendiente de confirmación" &&
            request.resource.data.documentoHashSha256 is string &&
            request.resource.data.documentoHashSha256.size() == 64 &&
            request.resource.data.documentoSubidoPorUid == request.auth.uid &&
            request.resource.data.confirmacionesFirma is map &&
            request.resource.data.confirmacionesFirma.cliente == (resource.data.clienteUid == request.auth.uid) &&
            request.resource.data.confirmacionesFirma.profesional == (resource.data.profesionalUid == request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "archivoFirmado", "archivoFirmadoRuta", "archivoFirmadoUrl",
              "documentoHashSha256", "documentoSubidoPorUid", "confirmacionesFirma",
              "estado", "actualizadoEn"
            ])
          ) ||
          (
            (resource.data.clienteUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid) &&
            resource.data.estado == "Pendiente de confirmación" &&
            request.resource.data.estado in ["Pendiente de confirmación", "Firmado"] &&
            request.resource.data.documentoHashSha256 == resource.data.documentoHashSha256 &&
            request.resource.data.archivoFirmadoRuta == resource.data.archivoFirmadoRuta &&
            request.resource.data.confirmacionesFirma is map &&
            request.resource.data.confirmacionesFirma.cliente is bool &&
            request.resource.data.confirmacionesFirma.profesional is bool &&
            (
              (resource.data.clienteUid == request.auth.uid &&
               request.resource.data.confirmacionesFirma.cliente == true &&
               request.resource.data.confirmacionesFirma.profesional == resource.data.confirmacionesFirma.profesional) ||
              (resource.data.profesionalUid == request.auth.uid &&
               request.resource.data.confirmacionesFirma.profesional == true &&
               request.resource.data.confirmacionesFirma.cliente == resource.data.confirmacionesFirma.cliente)
            ) &&
            request.resource.data.estado == (
              request.resource.data.confirmacionesFirma.cliente && request.resource.data.confirmacionesFirma.profesional
                ? "Firmado"
                : "Pendiente de confirmación"
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "confirmacionesFirma", "estado", "actualizadoEn"
            ])
          ) ||
          (
            autenticado() &&
            resource.data.profesionalUid == request.auth.uid &&
            resource.data.estado in ["Pendiente de firma", "Pendiente de confirmación", "Firmado", "En ejecución", "Pausado", "Finalizado"] &&
            request.resource.data.estado == resource.data.estado &&
            request.resource.data.anexoPlanTrabajoNombre is string &&
            request.resource.data.anexoPlanTrabajoNombre != "" &&
            request.resource.data.anexoPlanTrabajoRuta is string &&
            request.resource.data.anexoPlanTrabajoRuta != "" &&
            request.resource.data.anexoPlanTrabajoActualizadoEn is string &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "anexoPlanTrabajoNombre", "anexoPlanTrabajoRuta",
              "anexoPlanTrabajoActualizadoEn", "actualizadoEn"
            ])
          ) ||
          (
            pvRol("profesional") &&
            resource.data.profesionalUid == request.auth.uid &&
            resource.data.estado == "Firmado" &&
            request.resource.data.estado == "En ejecución" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "iniciadoPorUid", "iniciadoEn", "actualizadoEn"
            ])
          ) ||
          (
            pvRol("profesional") &&
            resource.data.profesionalUid == request.auth.uid &&
            resource.data.estado == "En ejecución" &&
            request.resource.data.estado == "Finalizado" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "evidenciasFinalizacion", "notaFinalizacion",
              "finalizadoPorUid", "finalizadoEn", "actualizadoEn"
            ])
          ) ||
          (
            pvRol("cliente") &&
            resource.data.clienteUid == request.auth.uid &&
            resource.data.estado == "Finalizado" &&
            request.resource.data.estado == "Cerrado" &&
            request.resource.data.calificacion is int &&
            request.resource.data.calificacion >= 1 &&
            request.resource.data.calificacion <= 5 &&
            request.resource.data.actaConformidad is map &&
            request.resource.data.actaConformidad.version == 1 &&
            request.resource.data.actaConformidad.aceptadaPorUid == request.auth.uid &&
            request.resource.data.actaConformidad.clienteUid == resource.data.clienteUid &&
            request.resource.data.actaConformidad.profesionalUid == resource.data.profesionalUid &&
            request.resource.data.actaConformidad.totalContrato == resource.data.total &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "calificacion", "comentarioCliente",
              "cerradoPorUid", "cerradoEn", "actaConformidad", "garantiaInicioEn",
              "garantiaVenceEn", "actualizadoEn"
            ])
          ) ||
          (
            pvRol("cliente") &&
            resource.data.clienteUid == request.auth.uid &&
            resource.data.estado == "Cerrado" &&
            request.resource.data.estado == "Cerrado" &&
            resource.data.keys().hasAll([
              "garantiaDias", "garantiaInicioEn", "garantiaVenceEn"
            ]) &&
            resource.data.garantiaDias is int &&
            resource.data.garantiaDias > 0 &&
            resource.data.garantiaInicioEn == "" &&
            resource.data.garantiaVenceEn == "" &&
            request.resource.data.garantiaInicioEn is string &&
            request.resource.data.garantiaVenceEn is string &&
            request.resource.data.garantiaInicioEn != "" &&
            request.resource.data.garantiaVenceEn != "" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "garantiaInicioEn", "garantiaVenceEn", "actualizadoEn"
            ])
          )
        )
      );
      allow delete: if esAdmin();
    }

    match /pv_mensajes_contrato/{mensajeId} {
      function contratoMensaje() {
        return get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data;
      }

      allow create: if autenticado() &&
        request.resource.data.id == mensajeId &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.mensaje is string &&
        request.resource.data.mensaje.size() > 0 &&
        request.resource.data.mensaje.size() <= 2000 &&
        (esAdmin() || contratoMensaje().clienteUid == request.auth.uid || contratoMensaje().profesionalUid == request.auth.uid) &&
        request.resource.data.clienteUid == contratoMensaje().clienteUid &&
        request.resource.data.profesionalUid == contratoMensaje().profesionalUid;
      allow read: if esAdmin() || (autenticado() &&
        (resource.data.clienteUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid));
      allow update, delete: if false;
    }

    match /pv_actuaciones_contrato/{actuacionId} {
      function contratoActuacion() {
        return get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data;
      }

      allow create: if autenticado() &&
        request.resource.data.id == actuacionId &&
        request.resource.data.solicitanteUid == request.auth.uid &&
        request.resource.data.tipo in ["Pausa", "Reanudación", "Cancelación"] &&
        request.resource.data.estado == "Solicitada" &&
        request.resource.data.motivo is string &&
        request.resource.data.motivo.size() >= 10 &&
        request.resource.data.motivo.size() <= 1500 &&
        (esAdmin() || contratoActuacion().clienteUid == request.auth.uid || contratoActuacion().profesionalUid == request.auth.uid) &&
        request.resource.data.clienteUid == contratoActuacion().clienteUid &&
        request.resource.data.profesionalUid == contratoActuacion().profesionalUid;
      allow read: if esAdmin() || (autenticado() &&
        (resource.data.clienteUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid));
      allow update: if adminPuede("soporte") && resource.data.estado == "Solicitada" &&
        request.resource.data.estado in ["Aceptada", "Rechazada"] &&
        request.resource.data.resolucion is string &&
        request.resource.data.resolucion.size() >= 10 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "resolucion", "resueltoPorUid", "resueltoEn", "actualizadoEn"
        ]);
      allow delete: if false;
    }

    match /pv_hitos/{hitoId} {
      function contratoHito() {
        return get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data;
      }

      allow create: if pvRol("profesional") &&
        request.resource.data.id == hitoId &&
        request.resource.data.profesionalUid == request.auth.uid &&
        request.resource.data.estado == "Pendiente" &&
        request.resource.data.evidencias is list &&
        request.resource.data.evidencias.size() == 0 &&
        contratoHito().estado == "En ejecución" &&
        contratoHito().profesionalUid == request.auth.uid &&
        request.resource.data.clienteUid == contratoHito().clienteUid;
      allow read: if esAdmin() || (autenticado() && (
        resource.data.clienteUid == request.auth.uid ||
        resource.data.profesionalUid == request.auth.uid
      ));
      allow update: if esAdmin() || (
        autenticado() &&
        request.resource.data.contratoId == resource.data.contratoId &&
        request.resource.data.clienteUid == resource.data.clienteUid &&
        request.resource.data.profesionalUid == resource.data.profesionalUid && (
          (
            pvRol("profesional") && resource.data.profesionalUid == request.auth.uid &&
            resource.data.estado in ["Pendiente", "Observado"] &&
            request.resource.data.estado == "En revisión" &&
            request.resource.data.evidencias is list &&
            request.resource.data.evidencias.size() > 0 &&
            request.resource.data.evidencias.size() <= 6 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "evidencias", "notaProfesional", "comentarioCliente",
              "enviadoPorUid", "enviadoEn", "actualizadoEn"
            ])
          ) || (
            pvRol("cliente") && resource.data.clienteUid == request.auth.uid &&
            resource.data.estado == "En revisión" &&
            request.resource.data.estado in ["Aprobado", "Observado"] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "comentarioCliente", "revisadoPorUid", "revisadoEn", "actualizadoEn"
            ])
          )
        )
      );
      allow delete: if esAdmin();
    }

    match /pv_pagos_declarados/{pagoId} {
      function contratoPago() {
        return get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data;
      }

      allow create: if pvRol("cliente") &&
        request.resource.data.id == pagoId &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.estado == "Declarado" &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        contratoPago().estado in ["En ejecución", "Finalizado"] &&
        contratoPago().clienteUid == request.auth.uid &&
        request.resource.data.profesionalUid == contratoPago().profesionalUid;
      allow read: if esAdmin() || (autenticado() && (
        resource.data.clienteUid == request.auth.uid ||
        resource.data.profesionalUid == request.auth.uid
      ));
      allow update: if esAdmin() || (
        autenticado() &&
        request.resource.data.contratoId == resource.data.contratoId &&
        request.resource.data.clienteUid == resource.data.clienteUid &&
        request.resource.data.profesionalUid == resource.data.profesionalUid &&
        request.resource.data.monto == resource.data.monto && (
          (
            pvRol("cliente") && resource.data.clienteUid == request.auth.uid &&
            resource.data.estado == "Declarado" && request.resource.data.estado == "Declarado" &&
            resource.data.comprobante == null && request.resource.data.comprobante is map &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["comprobante", "actualizadoEn"])
          ) || (
            pvRol("profesional") && resource.data.profesionalUid == request.auth.uid &&
            resource.data.estado == "Declarado" && request.resource.data.estado in ["Confirmado", "Rechazado"] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "comentarioProfesional", "revisadoPorUid", "revisadoEn", "actualizadoEn"
            ])
          )
        )
      );
      allow delete: if esAdmin();
    }

    match /pv_ordenes_cambio/{ordenId} {
      function contratoCambio() {
        return get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data;
      }

      allow create: if autenticado() &&
        request.resource.data.id == ordenId &&
        request.resource.data.estado == "Propuesta" &&
        request.resource.data.proponenteUid == request.auth.uid &&
        contratoCambio().estado == "En ejecución" &&
        request.resource.data.clienteUid == contratoCambio().clienteUid &&
        request.resource.data.profesionalUid == contratoCambio().profesionalUid &&
        request.auth.uid in [contratoCambio().clienteUid, contratoCambio().profesionalUid];
      allow read: if esAdmin() || (autenticado() && (
        resource.data.clienteUid == request.auth.uid ||
        resource.data.profesionalUid == request.auth.uid
      ));
      allow update: if esAdmin() || (
        autenticado() &&
        request.auth.uid in [resource.data.clienteUid, resource.data.profesionalUid] &&
        request.auth.uid != resource.data.proponenteUid &&
        resource.data.estado == "Propuesta" &&
        request.resource.data.estado in ["Aceptada", "Rechazada"] &&
        request.resource.data.contratoId == resource.data.contratoId &&
        request.resource.data.clienteUid == resource.data.clienteUid &&
        request.resource.data.profesionalUid == resource.data.profesionalUid &&
        request.resource.data.proponenteUid == resource.data.proponenteUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "respuesta", "resueltoPorUid", "resueltoEn", "actualizadoEn"
        ])
      );
      allow delete: if esAdmin();
    }

    match /pv_resenas/{contratoId} {
      allow read: if true;
      allow create: if pvRol("cliente") &&
        request.resource.data.contratoId == contratoId &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.calificacion is int &&
        request.resource.data.calificacion >= 1 &&
        request.resource.data.calificacion <= 5 &&
        getAfter(/databases/$(database)/documents/pv_contratos/$(contratoId)).data.estado == "Cerrado" &&
        getAfter(/databases/$(database)/documents/pv_contratos/$(contratoId)).data.clienteUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/pv_contratos/$(contratoId)).data.profesionalUid == request.resource.data.profesionalUid;
      allow update, delete: if esAdmin();
    }


    match /pv_reclamos/{reclamoId} {
      function participantesSinCambios() {
        return request.resource.data.clienteUid == resource.data.clienteUid &&
          request.resource.data.profesionalUid == resource.data.profesionalUid &&
          request.resource.data.contratoId == resource.data.contratoId &&
          request.resource.data.solicitudId == resource.data.solicitudId &&
          request.resource.data.cotizacionId == resource.data.cotizacionId;
      }

      function agregaHistorial(rol) {
        return request.resource.data.historial is list &&
          resource.data.historial is list &&
          request.resource.data.historial.size() == resource.data.historial.size() + 1 &&
          request.resource.data.historial[request.resource.data.historial.size() - 1].actorUid == request.auth.uid &&
          request.resource.data.historial[request.resource.data.historial.size() - 1].rol == rol;
      }

      allow create: if pvRol("cliente") &&
        request.resource.data.keys().hasAll([
          "contratoId", "solicitudId", "cotizacionId", "clienteUid", "profesionalUid",
          "categoria", "descripcion", "solucionSolicitada", "estado", "archivosCliente",
          "archivosProfesional", "respuestaProfesional", "resolucionAdmin", "historial",
          "creadoEn", "actualizadoEn"
        ]) &&
        request.resource.data.keys().hasOnly([
          "contratoId", "solicitudId", "cotizacionId", "clienteUid", "profesionalUid",
          "categoria", "descripcion", "solucionSolicitada", "estado", "archivosCliente",
          "archivosProfesional", "respuestaProfesional", "resolucionAdmin", "historial",
          "creadoEn", "actualizadoEn"
        ]) &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.estado == "Abierto" &&
        request.resource.data.categoria in ["Defecto", "Trabajo incompleto", "Daño", "Incumplimiento", "Otro"] &&
        request.resource.data.descripcion is string &&
        request.resource.data.descripcion.size() >= 20 &&
        request.resource.data.descripcion.size() <= 2500 &&
        request.resource.data.solucionSolicitada is string &&
        request.resource.data.solucionSolicitada.size() >= 10 &&
        request.resource.data.solucionSolicitada.size() <= 1200 &&
        request.resource.data.archivosCliente is list &&
        request.resource.data.archivosCliente.size() == 0 &&
        request.resource.data.archivosProfesional is list &&
        request.resource.data.archivosProfesional.size() == 0 &&
        request.resource.data.respuestaProfesional == "" &&
        request.resource.data.resolucionAdmin == "" &&
        request.resource.data.historial is list &&
        request.resource.data.historial.size() == 1 &&
        request.resource.data.historial[0].actorUid == request.auth.uid &&
        request.resource.data.historial[0].rol == "cliente" &&
        request.resource.data.contratoId is string &&
        exists(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)) &&
        get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data.clienteUid == request.auth.uid &&
        get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data.profesionalUid == request.resource.data.profesionalUid &&
        get(/databases/$(database)/documents/pv_contratos/$(request.resource.data.contratoId)).data.estado == "Cerrado";

      allow read: if esAdmin() || (
        autenticado() &&
        (resource.data.clienteUid == request.auth.uid ||
         resource.data.profesionalUid == request.auth.uid)
      );

      allow update: if (
        pvRol("cliente") &&
        resource.data.clienteUid == request.auth.uid &&
        resource.data.estado == "Abierto" &&
        request.resource.data.estado == "Abierto" &&
        participantesSinCambios() &&
        resource.data.archivosCliente.size() == 0 &&
        request.resource.data.archivosCliente is list &&
        request.resource.data.archivosCliente.size() > 0 &&
        request.resource.data.archivosCliente.size() <= 6 &&
        agregaHistorial("cliente") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "archivosCliente", "actualizadoEn", "historial"
        ])
      ) || (
        pvRol("profesional") &&
        resource.data.profesionalUid == request.auth.uid &&
        participantesSinCambios() &&
        request.resource.data.estado == "Respondido" &&
        resource.data.estado in ["Abierto", "En revisión"] &&
        request.resource.data.respuestaProfesional is string &&
        request.resource.data.respuestaProfesional.size() >= 10 &&
        request.resource.data.respuestaProfesional.size() <= 2500 &&
        request.resource.data.archivosProfesional is list &&
        request.resource.data.archivosProfesional.size() <= 6 &&
        agregaHistorial("profesional") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "respuestaProfesional", "archivosProfesional", "estado", "actualizadoEn", "historial"
        ])
      ) || (
        pvRol("cliente") &&
        resource.data.clienteUid == request.auth.uid &&
        resource.data.estado == "Resuelto" &&
        request.resource.data.estado == "Cerrado" &&
        participantesSinCambios() &&
        agregaHistorial("cliente") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "actualizadoEn", "historial"
        ])
      ) || (
        esAdmin() &&
        resource.data.estado != "Cerrado" &&
        participantesSinCambios() &&
        request.resource.data.estado in ["En revisión", "Resuelto", "Cerrado"] &&
        request.resource.data.resolucionAdmin is string &&
        request.resource.data.resolucionAdmin.size() >= 10 &&
        request.resource.data.resolucionAdmin.size() <= 2500 &&
        agregaHistorial("admin") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "resolucionAdmin", "actualizadoEn", "historial"
        ])
      );

      allow delete: if false;
    }

    match /pv_notificaciones/{notificacionId} {
      function reclamoNotificacion() {
        return getAfter(/databases/$(database)/documents/pv_reclamos/$(request.resource.data.reclamoId)).data;
      }

      function actorValido() {
        return esAdmin() ||
          reclamoNotificacion().clienteUid == request.auth.uid ||
          reclamoNotificacion().profesionalUid == request.auth.uid;
      }

      function destinoValido() {
        return (
          request.resource.data.destinatarioRol == "cliente" &&
          request.resource.data.destinatarioUid == reclamoNotificacion().clienteUid
        ) || (
          request.resource.data.destinatarioRol == "profesional" &&
          request.resource.data.destinatarioUid == reclamoNotificacion().profesionalUid
        ) || (
          request.resource.data.destinatarioRol == "admin" &&
          request.resource.data.destinatarioUid == ""
        );
      }

      allow create: if autenticado() &&
        request.resource.data.keys().hasAll([
          "tipo", "reclamoId", "contratoId", "actorUid", "destinatarioUid",
          "destinatarioRol", "titulo", "mensaje", "leida", "leidaEn", "creadoEn"
        ]) &&
        request.resource.data.keys().hasOnly([
          "tipo", "reclamoId", "contratoId", "actorUid", "destinatarioUid",
          "destinatarioRol", "titulo", "mensaje", "leida", "leidaEn", "creadoEn"
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.reclamoId is string &&
        request.resource.data.contratoId == reclamoNotificacion().contratoId &&
        request.resource.data.tipo in [
          "reclamo_abierto", "respuesta_profesional", "admin_revision",
          "admin_resolver", "admin_cerrar", "cierre_cliente"
        ] &&
        request.resource.data.titulo is string &&
        request.resource.data.titulo.size() > 0 &&
        request.resource.data.titulo.size() <= 120 &&
        request.resource.data.mensaje is string &&
        request.resource.data.mensaje.size() > 0 &&
        request.resource.data.mensaje.size() <= 500 &&
        request.resource.data.leida == false &&
        request.resource.data.leidaEn == "" &&
        actorValido() &&
        destinoValido();

      allow read: if (
        esAdmin() && resource.data.destinatarioRol == "admin"
      ) || (
        autenticado() && resource.data.destinatarioUid == request.auth.uid
      );

      allow update: if (
        (esAdmin() && resource.data.destinatarioRol == "admin") ||
        (autenticado() && resource.data.destinatarioUid == request.auth.uid)
      ) &&
        request.resource.data.leida == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leida", "leidaEn"]);

      allow delete: if false;
    }

    match /pv_auditoria/{eventoId} {
      allow create: if autenticado() &&
        request.resource.data.actorUid == request.auth.uid &&
        (!("contexto" in request.resource.data) || request.resource.data.contexto is map) &&
        request.auth.uid in request.resource.data.participantes;
      allow read: if esAdmin() || (
        autenticado() && request.auth.uid in resource.data.participantes
      );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
